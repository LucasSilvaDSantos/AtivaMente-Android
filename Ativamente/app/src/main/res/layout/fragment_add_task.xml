<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dark_purple"
    android:padding="24dp">

    <View
        android:id="@+id/view_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/medium_purple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_add_task_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nova Tarefa"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_handle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_layout_task_title"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="O que você vai fazer?"
        android:textColorHint="@color/accent_purple"
        app:boxBackgroundColor="@color/medium_purple"
        app:boxStrokeColor="@color/accent_purple"
        app:hintTextColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/text_add_task_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_layout_task_description"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Notas (opcional)"
        android:textColorHint="@color/accent_purple"
        app:boxBackgroundColor="@color/medium_purple"
        app:boxStrokeColor="@color/accent_purple"
        app:hintTextColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/input_layout_task_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/layout_date_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/input_layout_task_description">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_select_date"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hoje"
            android:textColor="@color/white"
            app:icon="@android:drawable/ic_menu_today"
            app:iconTint="@color/accent_purple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_select_time"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="12:00"
            android:textColor="@color/white"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconTint="@color/accent_purple" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_routine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Repetir (Rotina)"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/layout_date_time"
        app:thumbTint="@color/accent_purple"
        app:trackTint="@color/medium_purple" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/switch_routine">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sun"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D"
            app:chipBackgroundColor="@color/medium_purple"
            app:chipCornerRadius="20dp"
            app:chipStrokeWidth="0dp"
            android:textColor="@color/white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_mon"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            app:chipBackgroundColor="@color/medium_purple"
            app:chipCornerRadius="20dp"
            app:chipStrokeWidth="0dp"
            android:textColor="@color/white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_tue"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T"
            app:chipBackgroundColor="@color/medium_purple"
            app:chipCornerRadius="20dp"
            app:chipStrokeWidth="0dp"
            android:textColor="@color/white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_wed"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q"
            app:chipBackgroundColor="@color/medium_purple"
            app:chipCornerRadius="20dp"
            app:chipStrokeWidth="0dp"
            android:textColor="@color/white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_thu"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q"
            app:chipBackgroundColor="@color/medium_purple"
            app:chipCornerRadius="20dp"
            app:chipStrokeWidth="0dp"
            android:textColor="@color/white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_fri"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            app:chipBackgroundColor="@color/medium_purple"
            app:chipCornerRadius="20dp"
            app:chipStrokeWidth="0dp"
            android:textColor="@color/white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sat"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            app:chipBackgroundColor="@color/medium_purple"
            app:chipCornerRadius="20dp"
            app:chipStrokeWidth="0dp"
            android:textColor="@color/white" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_save"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:text="Adicionar"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:backgroundTint="@color/accent_purple"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/chip_group_days" />

</androidx.constraintlayout.widget.ConstraintLayout>
